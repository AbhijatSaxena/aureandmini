# Admin login (required)
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie (required in production)
SESSION_SECRET=change-me-too
# Postgres connection string (Neon via Vercel Marketplace sets this for you).
# If empty, a local JSON file (.data/store.json) is used -- dev only, NOT persistent on Vercel.
DATABASE_URL=
# WhatsApp number shown on the site, digits only with country code (optional)
NEXT_PUBLIC_WHATSAPP=
