{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": {
    "backendId": "aureandmini",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".data",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "site": "aureandmini",
    "public": ".hosting-empty",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "aureandmini",
          "region": "us-east4"
        }
      }
    ]
  }
}