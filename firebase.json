{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": {
    "backendId": "aureandmini",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".data",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": {
    "site": "aureandmini",
    "public": ".hosting-empty",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://aureandmini--aureandmini.us-east4.hosted.app/:path*",
        "type": 302
      }
    ]
  }
}